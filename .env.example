# Hecate Core / shared workspace configuration (synthetic examples only).
# Copy to your hunt workspace's .env, or start with Hecate-Public/.env.example.
# Fill ONE model configuration for agentic features and ONE SIEM for live hunts.
# Other credentials are optional, depending on the integrations you enable.
# Uncomment and replace placeholders only in your ignored .env; never commit keys.
#
# Prefer one workspace .env shared by hecate-agent and hecate-runner. Export
# HECATE_WORKSPACE as the absolute workspace path before launching from elsewhere.
# Runner also reads a local .env as an override; avoid conflicting copies.
# Existing process environment variables take precedence over dotenv settings.
# HECATE_WORKSPACE=/absolute/path/to/Hecate-Public
# Compact workspace hunting guidance is on by default; the full reference is not injected.
# HECATE_HUNTING_KNOWLEDGE=true

# --- Model provider: required for agentic features ------------------------------
# Uncomment the provider/model lines and ONE matching credential below.
# Use a model ID available to your account or installed on your local server.
# Provider values: openai, litellm, bedrock, ollama. Set them explicitly to avoid
# selecting a different backend when several credentials are present.
#
# OpenAI or an OpenAI-compatible server:
# HECATE_LLM_PROVIDER=openai
# HECATE_LLM_MODEL=replace-with-your-model-id
# OPENAI_API_KEY=replace-with-your-api-key
# HECATE_LLM_BASE_URL=https://api.openai.com/v1
# For another compatible server, replace BASE_URL and supply its credential.
#
# Other choices: change PROVIDER/MODEL above; only uncomment matching credentials.
# Anthropic: PROVIDER=litellm; MODEL=anthropic/your-model-id
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# Gemini: PROVIDER=litellm; MODEL=gemini/your-model-id
# GOOGLE_API_KEY=replace-with-your-google-api-key
# Bedrock: PROVIDER=bedrock; MODEL=your-bedrock-model-or-inference-profile-id
# Prefer an AWS profile or the host's IAM role; keys below are an alternative.
# AWS_PROFILE=your-aws-profile
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-access-key
# AWS_SESSION_TOKEN=replace-with-your-temporary-session-token
# Ollama: PROVIDER=ollama; MODEL=your-installed-model-tag; no API key required.
# Set BASE_URL above to http://localhost:11434, or use OLLAMA_HOST instead.
# OLLAMA_HOST=http://localhost:11434
# HECATE_OLLAMA_TIMEOUT_SEC=180
# HECATE_OLLAMA_NUM_CTX=16384
# HECATE_OLLAMA_THINK=false

# Optional separate models for routine work and reasoning. Leave all unset for
# a single model. Each tier inherits unset values from the root configuration;
# supply that tier's BASE_URL too when switching to another backend.
# HECATE_LLM_SIMPLE_PROVIDER=ollama
# HECATE_LLM_SIMPLE_MODEL=your-installed-model-tag
# HECATE_LLM_SIMPLE_BASE_URL=http://localhost:11434
# Soft clip for simple-tier prompts (chars). Keep under HECATE_OLLAMA_NUM_CTX headroom.
# HECATE_LLM_SIMPLE_MAX_PROMPT_CHARS=12000
# HECATE_LLM_COMPLEX_PROVIDER=openai
# HECATE_LLM_COMPLEX_MODEL=replace-with-your-reasoning-model-id
# HECATE_LLM_COMPLEX_BASE_URL=https://api.openai.com/v1
# Demote locked capabilities only after:
#   hecate-agent eval --tier simple --write-gate <capability> --fail-under 0.8
# then set llm.defaults.<capability>: simple in .hecateconfig.yaml.
# HECATE_LLM_DEMOTION_GATES=/path/to/llm_demotion_gates.json
# Lab-only unlock (skips eval gates): HECATE_LLM_ALLOW_DEMOTION=1

# --- Optional research web search ---------------------------------------------
# Needed for Tavily-backed web search, not for executing existing hunt queries.
# TAVILY_API_KEY=replace-with-your-tavily-api-key

# --- Query execution: configure ONE backend -----------------------------------
# mock is offline. For live queries, change this to splunk, sentinel, elastic,
# or crowdstrike, and uncomment that backend's endpoint and credentials below.
HECATE_RUNNER_QUERY_PROVIDER=mock
HECATE_RUNNER_MAX_QUERY_TIME_RANGE_DAYS=7
HECATE_RUNNER_MAX_QUERY_LIMIT=1000

# Splunk management host (not the web UI); token must permit search.
# SPLUNK_HOST=splunk.example
# SPLUNK_TOKEN=replace-with-your-splunk-search-token
# SPLUNK_VERIFY_SSL=true
# Optional basic authentication instead of SPLUNK_TOKEN:
# SPLUNK_USERNAME=replace-with-your-splunk-username
# SPLUNK_PASSWORD=replace-with-your-splunk-password

# Microsoft Sentinel: Log Analytics workspace GUID and Logs API bearer token.
# This adapter takes an existing token; renew it before it expires.
# SENTINEL_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# SENTINEL_BEARER_TOKEN=replace-with-your-azure-logs-access-token
# AZURE_ACCESS_TOKEN is also accepted; use one token variable.

# Elasticsearch EQL endpoint (not Kibana); index must contain compatible events.
# ELASTIC_URL=https://elasticsearch.example:9200
# ELASTIC_API_KEY=replace-with-your-elasticsearch-api-key
# ELASTIC_INDEX=logs-endpoint-*
# ELASTIC_TIMESTAMP_FIELD=@timestamp

# CrowdStrike LogScale: instance URL, repository and read token.
# FALCON_LOGSCALE_URL=https://logscale.example
# FALCON_LOGSCALE_REPO=replace-with-your-logscale-repository
# FALCON_LOGSCALE_TOKEN=replace-with-your-logscale-read-token

# --- Optional observable enrichment -------------------------------------------
# Enable only services you use; these keys are not all required to run Hecate.
# Missing keys skip credential-dependent enrichment. Public lookups may still run.
# GREYNOISE_API_KEY=replace-with-your-greynoise-api-key
# SHODAN_API_KEY=replace-with-your-shodan-api-key
# CENSYS_API_TOKEN=replace-with-your-censys-api-token
# CENSYS_ORGANIZATION_ID=replace-with-your-censys-organization-id
# ABUSECH_API_KEY=replace-with-your-abusech-api-key
# ABUSEIPDB_API_KEY=replace-with-your-abuseipdb-api-key
# VT_API_KEY=replace-with-your-virustotal-api-key
# URLSCAN_API_KEY=replace-with-your-urlscan-api-key
# OTX_API_KEY=replace-with-your-otx-api-key
# SPUR_API_KEY=replace-with-your-spur-api-key
# MNEMONIC_API_KEY=replace-with-your-mnemonic-api-key
# IPINFO_TOKEN=replace-with-your-ipinfo-token
# HYBRID_ANALYSIS_API_KEY=replace-with-your-hybrid-analysis-api-key
# TRIAGE_API_KEY=replace-with-your-triage-api-key
# VULNCHECK_API_KEY=replace-with-your-vulncheck-api-key
# SHADOWSERVER_API_KEY=replace-with-your-shadowserver-api-key
# SHADOWSERVER_API_SECRET=replace-with-your-shadowserver-api-secret

# MISP enrichment/intake: instance URL and read credential.
# MISP_BASE_URL=https://misp.example
# MISP_API_KEY=replace-with-your-misp-read-api-key
# MISP_VERIFY_SSL=true
# HECATE_RUNNER_MISP_VERIFY_SSL=true

# Runner defaults to enabled BAS in mock mode, with unattended live execution off.
# To disable even the offline BAS step, explicitly set:
# HECATE_BAS_ENABLED=false
