# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/
.claude/

# Sensitive data
.env
*.env
# Backups and variants (sed -i.bak, editor copies) hold the same secrets.
.env.*
*.env.*
!.env.example
!config/.env.example
credentials/
secrets/

# User-specific Hecate config
.hecateconfig.yaml

# Workspace-local ATT&CK STIX cache (~52MB, regenerable via `hecate attack
# update`). Only lands here when the workspace has a .hecateconfig.yaml, which
# switches the cache from ~/.hecate/ to the workspace -- so it is easy to stage
# by accident.
.hecate/

# Evidence artifacts (optional - uncomment if you want to exclude large files)
# evidence/

# Demo recordings
*.cast
*.cast[0-9]

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg
MANIFEST

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
testing/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Plan documents (session-specific, not shared)
docs/plans/

# Talk submissions (private)
talks/

# Worktrees
.worktrees/

# Virtual environments
tools/mcp/venv/
venv/
demo-venv/
ENV/
env/
.venv/

# Local plan documents (session-specific)
Plans/

# Automation loop (local config and runtime state — never commit)
automation/config.json
automation/state.json
automation/state.json.tmp
automation/loop.log

# hecate-runner orchestrator (local runtime state — never commit)
.orchestrator_state.json
.otx_cursor_state.json
.rss_cursor_state.json
.misp_cursor_state.json
.multi_cti_cursor_state.json

# Hand-taken cursor backups (e.g. before seeding a MISP backfill). Local
# recovery aids, same runtime-state class as the cursors themselves.
*.pre-backfill.bak

# flock targets for ID allocation — created on demand, contents never read.
# Unanchored on purpose: a run from a different working directory drops these
# at the repo root rather than beside the counter, and one such stray was
# committed by mistake.
.hunt_id.lock
.research_id.lock

# One-off patch/migration scripts. Written to rewrite one file once, then
# spent; they are not re-runnable and must never be committed.
/patch*.py

.pending_queries/
logs/
cti_queue/

# Operational content (kept in dedicated workspace repo: BrizoSec/Hecate-Content)
hunts/
queries/
research/
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
